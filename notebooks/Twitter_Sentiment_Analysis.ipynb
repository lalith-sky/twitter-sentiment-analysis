import os

base = "/kaggle/working"

for root, dirs, files in os.walk(base):
    level = root.replace(base, "").count(os.sep)

    if level > 3:
        dirs[:] = []
        continue

    print("\nFolder:", root)

    for file in files:
        path = os.path.join(root, file)
        print(" ", file, round(os.path.getsize(path) / (1024**2), 2), "MB")
        


