import os
import zipfile

base = "/kaggle/working"
zip_path = os.path.join(base, "Twitter_Sentiment_Analysis.zip")

items = [
    "Twitter_Sentiment_Model",
    "Twitter_Sentiment_Model_Best",
    "training_history.csv",
    "independent_evaluation_results.csv",
    "independent_predictions.csv",
    "plots"
]

with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
    for item in items:
        path = os.path.join(base, item)

        if os.path.isfile(path):
            z.write(path, arcname=item)

        elif os.path.isdir(path):
            for root, dirs, files in os.walk(path):
                for file in files:
                    full_path = os.path.join(root, file)
                    arcname = os.path.relpath(full_path, base)
                    z.write(full_path, arcname)

print("ZIP ready:", os.path.exists(zip_path))
print("Size:", round(os.path.getsize(zip_path) / (1024**3), 2), "GB")


